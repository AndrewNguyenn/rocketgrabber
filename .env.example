# Copy this to .env (which is gitignored) and fill in values to enable
# the auto-fetch flow that polls Gmail for Rocket Money's export email.
#
# Generate an app-specific password at https://myaccount.google.com/apppasswords
# (requires 2FA on the Google account). Don't paste your real password.

GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
